        {"id": "palabras_ilegibles", "nombre": "Palabras Ilegibles", "descripcion": "Caracteres no reconocibles en el OCR", "fuente_default": "determinista", "metodo_default": "regex_ratio"},
        {"id": "ratio_imagenes", "nombre": "Ratio Imágenes/Texto", "descripcion": "Proporción de figuras vs contenido textual", "fuente_default": "determinista", "metodo_default": "element_count_ratio"},
        {"id": "largo_texto", "nombre": "Largo de Texto", "descripcion": "Cumplimiento de largo mínimo esperado", "fuente_default": "determinista", "metodo_default": "largo_texto"},
        {"id": "redundancia", "nombre": "Redundancia", "descripcion": "Nivel de repetición del contenido", "fuente_default": "determinista", "metodo_default": "compression_ratio"}
